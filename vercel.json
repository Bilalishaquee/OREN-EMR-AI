{
  "buildCommand": "cd server && npm install && cd .. && npm install && npm run build",
  "outputDirectory": "dist",
  "installCommand": "cd server && npm install && cd .. && npm install",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 300,
      "memory": 3008,
      "runtime": "nodejs20.x"
    }
  },
  "env": {
    "NODE_ENV": "production"
  }
}


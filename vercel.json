{
  "version": 2,
  "buildCommand": "cd server && npm install && cd ..",
  "installCommand": "cd server && npm install && cd ..",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index.js"
    }
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 300,
      "memory": 3008,
      "runtime": "nodejs20.x",
      "includeFiles": "server/**"
    }
  }
}

